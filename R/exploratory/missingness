# surv_df is large, take random sample
sample_surv_df = surv_df[sample(nrow(surv_df), 10000), ]

# quick look at surveillance 
visdat::vis_dat(sample_surv_df,
                sort_type = TRUE) + 
  labs(title = "Surveillance Data")
# similarly missing most confirmed cases and a lot of confirmed deaths, some adm2 and almost no adm3
